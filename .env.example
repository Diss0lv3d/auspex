# Auspex environment — every var here is documented in docs/ENV_VARS.md
APP_ENV=dev
# --- OpenSearch (search/KB/telemetry; D-001, D-004) ---
OPENSEARCH_LOGS_HOST=<https://your-cluster-host>
OPENSEARCH_LOGS_USER=<user>
OPENSEARCH_LOGS_PASS=<REDACTED>
OPENSEARCH_PORT=25060
# --- Postgres (transactional truth; D-001) ---
DATABASE_URL=postgresql://auspex:auspex@postgres:5432/auspex
# --- LLM (customer-supplied, OpenAI-compatible; D-005) ---
LLM_BASE_URL=<https://your-openai-compatible-endpoint>
LLM_MODEL=<model-name>
LLM_API_KEY=
# --- Auth ---
SECRET_KEY=<REDACTED>
GOOGLE_CLIENT_ID=
