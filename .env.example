# Auspex environment — every var here is documented in docs/ENV_VARS.md
APP_ENV=dev
# --- Postgres (transactional truth; D-001) ---
DATABASE_URL=postgresql://auspex:auspex@postgres:5432/auspex
# --- OpenSearch (own container; D-001, D-009). Local container runs with the
#     security plugin disabled, so USER/PASS are ignored locally (real clusters use them).
OPENSEARCH_URL=http://opensearch:9200
OPENSEARCH_USER=admin
OPENSEARCH_PASS=<REDACTED>
# --- LLM (customer-supplied, OpenAI-compatible; D-005). First used in S2. ---
# Dev primary (D-015): Llama-4-Scout via Northflank — a normal remote HTTPS URL
#   (same from host and container; nothing special needed).
# Dev secondary/offline (D-013): local Ollama qwen3:14b —
#   container: LLM_BASE_URL=http://host.docker.internal:11434 (compose host-gateway alias)
#   host runs: LLM_BASE_URL=http://localhost:11434
LLM_BASE_URL=<https://your-openai-compatible-endpoint>
LLM_MODEL=<model-name>
LLM_API_KEY=
# --- Dev-only model switcher (D-016; internal infrastructure, never customer-facing) ---
# Point at a gitignored JSON registry (see dev-endpoints.example.json) to enable
# the /api/models switcher. Only honored when APP_ENV=dev. Leave empty to disable.
DEV_LLM_REGISTRY_FILE=

# --- Enrichment (S5) --- keyless sources (InternetDB, CIRCL hashlookup, OTX) are
# always on while enabled; the rest activate only when their key is set.
ENRICHMENT_ENABLED=true
# One free auth.abuse.ch key unlocks BOTH URLhaus and ThreatFox (register once).
ABUSECH_AUTH_KEY=
ABUSEIPDB_API_KEY=
# Optional: OTX answers without a key (probed); a key raises rate limits.
OTX_API_KEY=
GREYNOISE_API_KEY=

# --- Knowledge base (S6) --- lives on the OpenSearch container; embeddings are
# server-side via the ML plugin (D-018). Bootstrap is idempotent; first boot on a
# fresh volume downloads the embedding model (~12 s, needs outbound HTTPS).
KB_ENABLED=true
# NVD API key (free, https://nvd.nist.gov/developers/request-an-api-key): raises
# the CVE API quota 5→50 req/30s. Optional; S7 ingestion reads it (probe-verified
# 2026-07-17, sent as `apiKey` header).
NVD_API_KEY=

# --- Feed ingestion (S7) --- NVD delta + CISA KEV + FIRST EPSS merge into the
# knowledge base on a startup catch-up + hourly cycle. Inert unless KB_ENABLED.
# Host/test runs pin this false (hermetic); the container default is on.
INGEST_ENABLED=true

# --- Auth ---
# Required in prod; dev falls back to an ephemeral per-process key. openssl rand -hex 32
SECRET_KEY=<REDACTED>
JWT_TTL_MINUTES=720
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback
